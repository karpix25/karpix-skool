POSTGRES_USER=app_user
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_DB=app

# Docker Compose derives the in-container DATABASE_URL from POSTGRES_*.
# Use this direct-run URL for local backend commands outside Compose.
DATABASE_URL=postgresql+asyncpg://app_user:replace_with_strong_database_password@localhost:5432/app
DB_PASSWORD=replace_with_strong_database_password
SECRET_KEY=replace_with_at_least_32_random_characters
BOT_TOKEN=123456:replace_with_real_telegram_bot_token
BOT_USERNAME=your_bot_username
APP_SHORT_NAME=app
FRONTEND_URL=https://your-frontend.example.com
WEBAPP_URL=https://your-webapp.example.com
VITE_API_URL=https://your-api.example.com
ENVIRONMENT=production
SUPER_ADMIN_ID=123456789
REDIS_URL=redis://redis:6379/0
ENABLE_CACHE=true

R2_ACCOUNT_ID=your_cloudflare_r2_account_id
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_PUBLIC_URL=https://your-public-r2-url.example.com

GOOGLE_API_KEY=your_google_api_key
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
COURSE_STRUCTURE_PROVIDER=openrouter
COURSE_STRUCTURE_MODEL=google/gemini-2.5-flash
# Optional role overrides. Each falls back to COURSE_STRUCTURE_MODEL.
COURSE_PLANNER_MODEL=
COURSE_WRITER_MODEL=
COURSE_REVIEWER_MODEL=

# Open Notebook lesson generation core.
NOTEBOOK_GENERATION_PROVIDER=open_notebook
OPEN_NOTEBOOK_API_URL=http://open_notebook:5055/api
OPEN_NOTEBOOK_PASSWORD=
OPEN_NOTEBOOK_ENCRYPTION_KEY=replace_with_open_notebook_encryption_key
OPEN_NOTEBOOK_SURREAL_USER=root
OPEN_NOTEBOOK_SURREAL_PASSWORD=replace_with_open_notebook_surreal_password
OPEN_NOTEBOOK_SURREAL_NAMESPACE=open_notebook
OPEN_NOTEBOOK_SURREAL_DATABASE=open_notebook
OPEN_NOTEBOOK_ANSWER_TIMEOUT_SECONDS=900
OPEN_NOTEBOOK_SOURCE_POLL_SECONDS=2
OPEN_NOTEBOOK_SOURCE_POLL_ATTEMPTS=150
OPEN_NOTEBOOK_EMBED_SOURCES=false
OPEN_NOTEBOOK_TRANSFORMATION_MODEL_ID=

# Google NotebookLM mode via notebooklm-py. Use a dedicated Google account.
# Compose persists this directory in notebooklm_profile_data. Generate a
# storage_state.json on a trusted desktop and import it in the superadmin UI.
NOTEBOOKLM_HOME=/app/.notebooklm
NOTEBOOKLM_PROFILE=standard
NOTEBOOKLM_AUTH_BROWSER_URL=
NOTEBOOKLM_ASK_MIN_INTERVAL_SECONDS=8
NOTEBOOKLM_SOURCE_WAIT_TIMEOUT_SECONDS=180
API_URL=
LESSON_GENERATION_POLL_SECONDS=5

# Social video transcript sources for course generation.
SCRAPE_CREATORS_API_KEY=
SCRAPE_CREATORS_BASE_URL=https://api.scrapecreators.com
SCRAPE_CREATORS_TRANSCRIPT_LANGUAGE=
SCRAPE_CREATORS_TIKTOK_AI_FALLBACK=false

MUX_TOKEN_ID=your_mux_token_id
MUX_TOKEN_SECRET=your_mux_token_secret
MUX_WEBHOOK_SECRET=your_mux_webhook_secret
PAYMENT_WEBHOOK_SECRET=your_payment_webhook_secret
PAYMENT_AUTOMATION_ENABLED=false
SENTRY_DSN=
VITE_GEMINI_API_KEY=

# Security checklist:
# - Keep this file secret-free; put real values only in backend/.env or hosting secrets.
# - For Docker Compose, copy this file to the project-root .env and fill every required value.
# - Use unique production values for SECRET_KEY, BOT_TOKEN, POSTGRES_PASSWORD, DB_PASSWORD, and webhook secrets.
# - Rotate tokens immediately if they were committed, logged, or shared in chat.
