FROM python:3.11-slim

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .
RUN chmod +x entrypoint.sh
RUN addgroup --system --gid 1000 app \
    && adduser --system --uid 1000 --ingroup app --home /home/app app \
    && mkdir -p /home/app/.notebooklm \
    && chown -R app:app /app /home/app
USER app

# Entrypoint script handles migrations and then starts the CMD
ENTRYPOINT ["./entrypoint.sh"]

CMD ["gunicorn", "-w", "9", "-k", "uvicorn.workers.UvicornWorker", \
    "--worker-connections", "1000", \
    "--max-requests", "5000", \
    "--max-requests-jitter", "500", \
    "--timeout", "60", \
    "--graceful-timeout", "30", \
    "--no-control-socket", \
    "app.main:app", "--bind", "0.0.0.0:8000"]
