FROM mcr.microsoft.com/playwright:v1.61.1-noble

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        novnc \
        websockify \
        x11-utils \
        x11vnc \
        xvfb \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g notebooklm-mcp@2.0.0

COPY docker/notebooklm/start.sh /usr/local/bin/notebooklm-start
RUN chmod +x /usr/local/bin/notebooklm-start

ENV NOTEBOOKLM_TRANSPORT=http \
    NOTEBOOKLM_HOST=0.0.0.0 \
    NOTEBOOKLM_PORT=3000 \
    NOTEBOOKLM_PROFILE=standard \
    NOTEBOOKLM_AI_MARKER=false \
    BROWSER_CHANNEL=chromium \
    DISPLAY=:99 \
    HEADLESS=false \
    ANSWER_TIMEOUT_MS=900000 \
    NOTEBOOKLM_NOVNC_PORT=6080 \
    NOTEBOOKLM_VNC_PORT=5900 \
    NOTEBOOKLM_XVFB_SCREEN=1440x900x24 \
    XDG_DATA_HOME=/root/.local/share \
    XDG_CONFIG_HOME=/root/.config

EXPOSE 3000 6080

VOLUME ["/root/.local/share/notebooklm-mcp", "/root/.config/notebooklm-mcp"]

CMD ["notebooklm-start"]
